# Example terraform.tfvars
# Copy to terraform.tfvars and adjust values as needed
# DO NOT commit terraform.tfvars with real values

region             = "us-east-1"
cluster_name       = "eks-assessor"
kubernetes_version = "1.30"
node_instance_type = "t3.medium"
node_desired_size  = 1
node_min_size      = 1
node_max_size      = 3

# Optional: custom tags
tags = {
  Project     = "eks-migration-assessor"
  Environment = "dev"
  ManagedBy   = "terraform"
  Owner       = "platform-team"
}

# Optional: VPC CIDR
vpc_cidr = "10.0.0.0/16"

# Optional: CIDR blocks allowed to access the EKS cluster public endpoint
# Must be explicitly set (no default to 0.0.0.0/0)
# Example: ["203.0.113.10/32"]
# api_allowed_cidrs = ["203.0.113.10/32"]

# Optional: create Pod Identity association for app (requires OIDC provider)
create_app_pod_identity = true

# Optional: custom S3 bucket name (must be globally unique)
# If not set, a random suffix will be generated
# reports_bucket_name = "my-unique-assessor-reports"